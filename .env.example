# ---- API ----
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4010
# Public origin of the web app (used for CORS, links in emails, public booking/form URLs).
APP_ORIGIN=http://127.0.0.1:3010
COOKIE_SECURE=false
SESSION_DAYS=14

# ---- PostgreSQL (docker compose uses the same values) ----
POSTGRES_USER=knowcrm
POSTGRES_PASSWORD=knowcrm-local-only
POSTGRES_DB=knowcrm
POSTGRES_PORT=5440
DATABASE_URL=postgresql://knowcrm:knowcrm-local-only@127.0.0.1:5440/knowcrm

# ---- Local file storage (uploads are written under this directory) ----
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# ---- Email over SMTP (defaults to the bundled local Mailpit) ----
# Set MAIL_ENABLED=false to only record outgoing mail in the database outbox.
MAIL_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1030
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="KnowBook CRM <no-reply@knowbook-crm.local>"

# ---- Background worker (reminders, recurring invoices) ----
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=60

# ---- Web ----
# Where the Next.js server proxies /api requests.
API_INTERNAL_URL=http://127.0.0.1:4010
WEB_PORT=3010

# Load the demo workspace when the API starts with an empty database.
DEMO_SEED=false
